# ==================================================
# AGRI NEXUS BACKEND — ENVIRONMENT TEMPLATE
# Copy to .env or configure in deployment environment
# DO NOT COMMIT SECRETS OR REAL API KEYS
# ==================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/agrinexus?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT (HMAC-SHA256 256-bit Key)
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External Weather Provider (Optional Key & Custom URL)
WEATHER_API_KEY=your_weather_api_key_here_if_required
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_PROVIDER=open-meteo
WEATHER_CURRENT_TTL_MINUTES=10
WEATHER_FORECAST_TTL_MINUTES=30

# External Agricultural Market Provider (Optional Key & Custom URL)
MARKET_API_KEY=your_mandi_market_api_key_here_if_required
MARKET_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_PROVIDER=database
MARKET_CACHE_TTL_MINUTES=15
